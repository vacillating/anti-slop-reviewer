# Copy to .env.local and fill in. Any OpenAI-compatible chat API works.
# The key is only read by the server routes; it never reaches the browser.

# DeepSeek (default; LLM_BASE_URL and LLM_MODEL can be left out)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-...

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Older setups: DEEPSEEK_API_KEY still works when LLM_API_KEY is not set.
# DEEPSEEK_API_KEY=sk-...
